# Oracle 9.2.0.4's reply to the describe-columns call (0x62) for `SELECT *` of
# a table `(d DATE, n NUMBER(6,2), nc NCHAR(4), ri ROWID, cl CLOB)`, #2326: a
# DATE and a ROWID describe a buffer of 1, the NUMBER 22, the NCHAR 8 bytes in
# AL16UTF16 (charset 2000), the CLOB 4000. Captured from seerdb's own session
# as `hexdump -C` output; the offset column and the |ascii| gutter are ignored
# by tests.replay.parse_hexdump.
00000000  08 01 05 0c 00 00 00 01  01 00 00 00 00 00 00 01  |................|
00000010  01 01 01 01 44 00 00 02  00 06 01 02 01 16 00 00  |....D...........|
00000020  00 00 00 00 01 01 01 01  01 4e 00 00 60 80 00 00  |.........N..`...|
00000030  01 08 00 02 10 00 00 00  02 07 d0 02 01 02 01 02  |................|
00000040  02 4e 43 00 00 0b 00 00  00 01 01 00 00 00 00 00  |.NC.............|
00000050  00 01 02 01 02 02 52 49  00 00 70 80 00 00 02 0f  |......RI..p.....|
00000060  a0 00 00 00 00 01 1f 01  01 02 01 02 02 43 4c 00  |.............CL.|
00000070  00 04 00 00 00 00 01 01  00 03 00 00 00 00 00 00  |................|
00000080  00 00 00 00 00 00 00 00  01 01 00 00 00 00        |..............|
