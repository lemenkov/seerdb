#
# Oracle 8.1.7's reply to the fetch of `SELECT k, CASE WHEN k <> 2 THEN rowid
# END r` from an index-organized table of three rows, #2328: the rows for k = 2,
# its UROWID NULL, `00 00 ff ff 00 00`, and k = 3, its UROWID `0a 00` and the
# 10-byte logical rowid, then ORA-01403. Captured from seerdb's own session as
# `hexdump -C` output; the offset column and the |ascii| gutter are ignored by
# tests.replay.parse_hexdump.
00000000  06 02 02 00 00 00 64 00  00 00 01 00 00 00 01 03  |......d.........|
00000010  00 00 00 00 07 02 c1 03  00 00 00 00 00 00 ff ff  |................|
00000020  00 00 06 02 02 00 01 00  64 00 00 00 01 00 00 00  |........d.......|
00000030  01 03 00 00 00 00 07 02  c1 04 00 00 00 00 0a 00  |................|
00000040  0a 02 04 01 40 00 c7 02  c1 04 fe 00 00 00 00 04  |....@...........|
00000050  03 00 00 00 7b 05 00 00  00 00 01 00 00 00 03 00  |....{...........|
00000060  60 00 00 09 17 5b 02 00  05 00 00 c7 00 00 00 00  |`....[..........|
00000070  00 00 00 00 00 00 18 00  00 01 00 00 00 00 00 00  |................|
00000080  00 00 00 00 00 00 00 00  00 00 00 19 4f 52 41 2d  |............ORA-|
00000090  30 31 34 30 33 3a 20 6e  6f 20 64 61 74 61 20 66  |01403: no data f|
000000a0  6f 75 6e 64 0a                                    |ound.|
000000a5
