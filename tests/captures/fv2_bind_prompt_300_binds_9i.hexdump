#
# Oracle 9.2.0.4's bind prompt for a PL/SQL block of 300 binds, #2311:
# `BEGIN IF :1 IS NULL THEN NULL; END IF; :2 := :1 + :3 + ... + :300; END;`,
# :1 a Var holding 5, :2 a Var, the rest ones. Its bind count is the low byte
# and then the high byte, each a ub4: `01 2c`, `01 01`. Then one direction
# per bind: 20 (IN), 10 (OUT), 20 x 298. Captured as `hexdump -C` output; the
# offset column and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  0b 05 01 2c 01 01 01 01  00 00 00 20 10 20 20 20  |...,....... .   |
00000010  20 20 20 20 20 20 20 20  20 20 20 20 20 20 20 20  |                |
00000020  20 20 20 20 20 20 20 20  20 20 20 20 20 20 20 20  |                |
00000030  20 20 20 20 20 20 20 20  20 20 20 20 20 20 20 20  |                |
00000040  20 20 20 20 20 20 20 20  20 20 20 20 20 20 20 20  |                |
00000050  20 20 20 20 20 20 20 20  20 20 20 20 20 20 20 20  |                |
00000060  20 20 20 20 20 20 20 20  20 20 20 20 20 20 20 20  |                |
