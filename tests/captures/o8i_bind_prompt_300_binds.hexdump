#
# Oracle 8.1.7's reply to the same 300-bind PL/SQL block as
# fv2_bind_prompt_300_binds_9i.hexdump, #2311: the bind prompt, whose count is
# the low byte and then the high byte, each a 2-byte little-endian field:
# `2c 00`, `01 00`; one direction per bind, 20, 10, 20 x 298; then the OUT
# value's RXD and the status. Captured as `hexdump -C` output; the offset
# column and the |ascii| gutter are ignored by tests.replay.parse_hexdump.
00000000  0b 05 2c 00 01 00 01 00  00 00 00 00 00 00 00 00  |..,.............|
