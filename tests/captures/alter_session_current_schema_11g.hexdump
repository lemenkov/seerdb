#
# A live Oracle 11.2 XE reply to `ALTER SESSION SET CURRENT_SCHEMA = SYSTEM`,
# captured through tools/capture_proxy.py. The return-parameters block
# (TTI_RPA) carries TWO key/value pairs -- the new schema name under keyword
# 168 and its id under 169 -- ahead of the OER. 23ai reports the same change
# in a server piggyback instead and leaves the RPA pair count at zero.
00000000  00 53 00 00 06 00 00 00  00 00 08 01 06 03 c1 40  |.S.............@|
00000010  83 00 01 02 01 02 00 00  00 01 02 01 06 06 53 59  |..............SY|
00000020  53 54 45 4d 00 01 a8 00  01 04 04 00 00 00 05 01  |STEM............|
00000030  a9 00 04 01 05 01 06 00  00 00 00 01 02 00 2a 00  |..............*.|
00000040  00 00 00 00 00 00 00 00  00 00 00 09 00 01 01 00  |................|
00000050  00 00 00                                          |...|
